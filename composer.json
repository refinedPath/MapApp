{
    "name": "refinedpath/mapapp",
    "description": "A personal map for dropping, tagging, and filtering places.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "ext-mbstring": "*",
        "slim/slim": "^4",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "vlucas/phpdotenv": "^5.6",
        "symfony/uid": "^7.4",
        "firebase/php-jwt": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "robmorgan/phinx": "^0.16.12",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}
